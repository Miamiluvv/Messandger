# ───── Среда ─────
ENV=development                     # production / development

# ───── База данных ─────
DATABASE_URL=sqlite+aiosqlite:///./messenger.db
# Для шифрования SQLite через SQLCipher (требует пакет sqlcipher3-binary):
DB_ENCRYPTION_KEY=
# Принудительный TLS для PostgreSQL (sslmode=require):
DB_REQUIRE_TLS=true

# ───── Аутентификация ─────
SECRET_KEY=ОБЯЗАТЕЛЬНО_СМЕНИТЬ_В_PRODUCTION_минимум_32_символа
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ───── CORS ─────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ───── Загрузки ─────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
# ALLOWED_UPLOAD_EXT=jpg,jpeg,png,gif,webp,...

# ───── Бэкапы БД ─────
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=30
